# cookpit.spaicestudio.cz na Railway. TLS končí na hraně Railway, kontejner mluví jen HTTP.
{
	auto_https off
	admin off
	persist_config off
}

:{$PORT} {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# Universal links: iOS čte soubor bez přípony jen jako JSON
	@aasa path /.well-known/apple-app-site-association
	header @aasa Content-Type "application/json"

	# Pozvánka a sdílený recept bez nainstalované aplikace: stránka v 404.html je obslouží podle adresy
	@handoff path /pozvanka/* /recept/*
	rewrite @handoff /404.html

	@fonts path /assets/fonts/*
	header @fonts Cache-Control "public, max-age=31536000, immutable"
	@media path *.webp *.jpg *.jpeg *.png *.svg *.ico
	header @media Cache-Control "public, max-age=86400"
	@rest not path /assets/fonts/* *.webp *.jpg *.jpeg *.png *.svg *.ico
	header @rest Cache-Control "public, max-age=0, must-revalidate"

	file_server

	handle_errors {
		@404 expression `{err.status_code} == 404`
		handle @404 {
			header Cache-Control "no-store"
			rewrite * /404.html
			file_server
		}
	}
}
